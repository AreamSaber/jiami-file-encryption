{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Security Settings Schema",
  "description": "安全设置的JSON Schema",
  "type": "object",
  "required": [
    "security_settings"
  ],
  "properties": {
    "security_settings": {
      "type": "object",
      "properties": {
        "key_management": {
          "type": "object",
          "properties": {
            "key_derivation": false,
            "key_generation": {
              "type": "object",
              "description": "当前生成随机密钥；未实现口令派生。",
              "required": [
                "source"
              ],
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": "string",
                  "const": "os.urandom"
                }
              }
            }
          }
        },
        "anti_reverse_engineering": false,
        "performance": {
          "type": "object",
          "properties": {
            "threading": {
              "type": "object",
              "properties": {
                "max_threads": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "memory": {
              "type": "object",
              "properties": {
                "buffer_size_mb": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
